# Aadalat AI — Environment Configuration
# Copy this file to .env and fill in your values

# App
APP_NAME=Aadalat AI
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key

# Database (PostgreSQL)
POSTGRES_USER=aadalat
POSTGRES_PASSWORD=aadalat
POSTGRES_DB=aadalat_ai
DATABASE_URL=postgresql+asyncpg://aadalat:aadalat@db:5432/aadalat_ai

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Provider (openai | anthropic | huggingface | local)
LLM_PROVIDER=huggingface

# API Keys (fill only the provider you choose)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Groq API (for adversarial courtroom argument generation)
# Get your key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LEGAL_NER_MODEL=dslim/bert-base-NER
LEGAL_CLASSIFIER_MODEL=facebook/bart-large-mnli
NLI_MODEL=roberta-large-mnli
SUMMARIZATION_MODEL=facebook/bart-large-cnn

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_RETRIEVAL_RESULTS=20
RERANK_TOP_K=10

# Court Data
ECOURTS_BASE_URL=https://ecourts.gov.in
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
