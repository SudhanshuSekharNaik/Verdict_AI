{
  "buildCommand": "pip install -r backend/requirements-deploy.txt",
  "installCommand": "pip install -r backend/requirements-deploy.txt",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "/var/task"
  }
}
